{
  "name": "@olaservo/forge-mcp-server",
  "version": "0.5.2",
  "description": "MCP server that lets an agent take a seat in a Forge (Card-Forge) network draft or match through a headless Forge client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "forge-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "bridge"
  ],
  "forgeAgentBridge": {
    "version": "0.1.11",
    "forge": "2.0.16",
    "sha256": "d4f2e4eaea9313f9779f258c75662d3d0179c59638cdcc303b2552b58cc62fdd"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "magic-the-gathering",
    "mtg",
    "forge",
    "draft"
  ],
  "author": {
    "name": "Carbon-Based Content LLC",
    "url": "https://www.carbonbasedcontent.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olaservo/forge-mcp-server.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run fetch-bridge && npm run build",
    "fetch-bridge": "node scripts/fetch-bridge.mjs",
    "typecheck": "tsc --noEmit && tsc -p test",
    "lint": "eslint .",
    "test": "vitest run --dir test",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js streamableHttp",
    "dev": "tsx src/index.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "plugin:chatgpt": "node scripts/build-chatgpt-plugin.mjs",
    "check:decks": "node scripts/check-deck-sites.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "pngjs": "^7.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.15.0",
    "standardwebhooks": "^1.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.0.0"
  }
}
