{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "forge": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@olaservo/forge-mcp-server"],
      "env": { "FORGE_MCP_PORT": "3080" }
    },
    "scryfall": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@olaservo/scryfall-mcp-server"]
    }
  }
}
